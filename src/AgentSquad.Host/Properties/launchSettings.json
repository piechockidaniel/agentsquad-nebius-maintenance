{
  "profiles": {
    "AgentSquad.Host": {
      "commandName": "Project",
      "launchBrowser": true,
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "AgentSquad__Maintenance__Enabled": "true",
        "AgentSquad__Maintenance__ScheduleCron": "0 0 1 1 *"
      },
      "applicationUrl": "https://localhost:53245;http://localhost:53246"
    },
    "Container (Dockerfile)": {
      "commandName": "Docker",
      "launchBrowser": true,
      "launchUrl": "{Scheme}://{ServiceHost}:{ServicePort}",
      "environmentVariables": {
        "ASPNETCORE_HTTPS_PORTS": "8081",
        "ASPNETCORE_HTTP_PORTS": "8080"
      },
      "publishAllPorts": true,
      "useSSL": true
    }
  }
}
