# Copy these names into the Container VM runtime environment. Do not commit the populated file.
# Every secret below must be a newly generated value or retrieved from the Nebius project owner.

# Required: Token Factory key permitted to list models and call the configured NVIDIA model.
NEBIUS_TOKEN_FACTORY_API_KEY=

# Optional for the Tavily bonus-evidence path. Dependency Sentinel uses it only after the fixed
# policy confirms an advisory, then stores at most three redacted sources from approved domains.
TAVILY_API_KEY=

# Required: ConTree / Token Factory Sandboxes credentials. Do not assume this is the same value as
# the inference key: ConTree access is granted separately and requires a project identifier.
CONTREE_TOKEN=
CONTREE_PROJECT=

# Required in Production: protects the public console with the browser's Basic-auth prompt.
# Choose a unique name and a random password with at least 20 characters.
AgentSquad__Web__OperatorUsername=
AgentSquad__Web__OperatorPassword=

# Required in Production: a separate random value with at least 32 characters. It protects every
# /maintenance API route after the operator challenge. Enter it in the console when demonstrating
# the app; it stays only in that browser tab's session storage.
AgentSquad__Web__AccessToken=

# Required to enable manual and scheduled sandbox runs after the credentials above are supplied.
AgentSquad__Maintenance__Enabled=true

# Optional: retain the v1 defaults unless the project owner specifies another permitted value.
# AgentSquad__Maintenance__ModelId=nvidia/nemotron-3-super-120b-a12b
# AgentSquad__Maintenance__ScheduleCron=30 7 * * 1-5
# AgentSquad__Maintenance__HistoryLimit=50
# AgentSquad__Maintenance__DefaultScenarioId=cache-repair
# CONTREE_URL=https://api.tokenfactory.nebius.com/sandboxes
